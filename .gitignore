# ==============================================================================
# Northstar Fitness Portfolio - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Build & Packaging Artifacts (>4.5 GB)
# ------------------------------------------------------------------------------
dist/
build/
*.zip
*.tar.gz
*.7z

# Analysis intermediate builds and preview workbooks
analysis/.workbook_previews/
analysis/.portfolio_build/
analysis/.interview_build/
analysis/.presentation_build/
analysis/.powerbi_native/
analysis/.powerbi_tools/
sql/.build/
.chart-data-*/

# Heavy JSON / formula scratch dumps
analysis/workbook_data.json
analysis/final_formula_cache.json

# ------------------------------------------------------------------------------
# 2. Power BI Developer Mode (.pbip) Local Caches & Settings
# ------------------------------------------------------------------------------
**/.pbi/cache.abf
**/.pbi/localSettings.json
*.pbix.backup

# ------------------------------------------------------------------------------
# 3. Python Virtual Environments, Bytecode & Caches
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 4. Node.js & Web Tooling
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Operating System & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 6. Temporary Files & Logs
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.log

# ------------------------------------------------------------------------------
# 7. Environment & Secrets (precautionary)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
