{
  "version": 1,
  "root_files": ["README.md", ".gitignore"],
  "folders": {
    "analysis": {"recursive": false, "suffixes": [".py", ".mjs", ".ps1", ".dax", ".md", ".json", ".csv", ".png", ".txt"]},
    "data": {"recursive": false, "suffixes": [".csv"]},
    "excel": {"recursive": false, "suffixes": [".xlsx"]},
    "powerbi": {"recursive": true, "suffixes": [".md", ".json", ".csv", ".pbip", ".pbix", ".pbir", ".pbism", ".tmdl", ".m", ".dax", ".png", ".jpg"]},
    "presentation": {"recursive": false, "suffixes": [".md", ".pptx", ".pdf"]},
    "images": {"recursive": true, "suffixes": [".png", ".jpg"]},
    "sql": {"recursive": true, "suffixes": [".py", ".sql", ".json", ".md"]},
    "portfolio": {"recursive": true, "suffixes": [".md", ".json"]}
  },
  "exclude_components": [".pbi", "node_modules", "__pycache__", ".build", ".portfolio_build", ".presentation_build", ".workbook_previews", "python_packages"],
  "exclude_files": ["analysis/workbook_data.json", "analysis/final_formula_cache.json", "analysis/portfolio_validation.json", "analysis/portfolio_validation.md"],
  "extra_files": ["powerbi/.gitignore"],
  "supplemental_files": [
    "analysis/workbook_data.json",
    "analysis/final_formula_cache.json",
    "analysis/.workbook_previews/phase3_payload.json",
    "analysis/.workbook_previews/phase4/payload.json",
    "analysis/.workbook_previews/phase5/payload.json",
    "analysis/.workbook_previews/phase6/payload.json",
    "analysis/.workbook_previews/phase6/joint_draws.npz",
    "analysis/.workbook_previews/phase6/layout.json",
    "analysis/.workbook_previews/phase6/input_workbook.xlsx",
    "analysis/.workbook_previews/phase6/final_values.json",
    "analysis/.workbook_previews/phase6/final_formulas.json",
    "analysis/.workbook_previews/phase6/guide_updates.json",
    "analysis/.workbook_previews/phase6/segments.json",
    "analysis/.workbook_previews/phase7/payload.json",
    "analysis/.workbook_previews/phase7/layout.json",
    "analysis/.workbook_previews/phase7/final_values.json",
    "analysis/.workbook_previews/phase7/final_formulas.json",
    "analysis/.workbook_previews/phase7/guide_updates.json",
    "analysis/.workbook_previews/phase7/segments.json",
    "analysis/.workbook_previews/phase8/payload.json",
    "analysis/.workbook_previews/phase8/layout.json",
    "analysis/.workbook_previews/phase8/final_values.json",
    "analysis/.workbook_previews/phase8/final_formulas.json",
    "analysis/.workbook_previews/phase8/guide_updates.json",
    "analysis/.workbook_previews/phase8/segments.json",
