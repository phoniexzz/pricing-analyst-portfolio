[Experiment Path Conversion] =
DIVIDE([Experiment Path Joins], [Experiment Path Prospects]) * 1

[Experiment Path Churn] =
DIVIDE([Experiment Path Incumbent Exits], [Experiment Path Incumbent Exposure]) * 1

[Experiment Path Downgrade Rate] =
DIVIDE([Experiment Path Downgrades], [Experiment Path Incumbent Exposure]) * 1

[Experiment Path ARPMM] =
DIVIDE([Experiment Path Revenue], [Experiment Path Average Exposure]) * 1

[Experiment Path Subscription Yield] =
DIVIDE([Experiment Path Subscription], [Experiment Path Average Exposure]) * 1

[Experiment Path Standard Yield] =
DIVIDE([Experiment Path Standard Revenue], [Experiment Path Standard Exposure]) * 1

[Experiment Path Complaints per 1000] =
DIVIDE([Experiment Path Complaints], [Experiment Path Average Exposure]) * 1000

[Experiment Path Paid Rate] =
DIVIDE([Experiment Path Paid Rate Numerator], [Experiment Path Incumbent Exposure]) * 1

[Experiment Path Protected Share] =
DIVIDE([Experiment Path Protected Exposure], [Experiment Path Incumbent Exposure]) * 1

[Experiment Path Repriced Share] =
DIVIDE([Experiment Path Repriced Exposure], [Experiment Path Incumbent Exposure]) * 1

[Experiment Path Closing] =
VAR Checkpoint = SELECTEDVALUE(DimCheckpoint[checkpoint_months],6) VAR LastMonth = CALCULATE(MAX(FactExperimentPath[month]), KEEPFILTERS(DimExperimentMonth[month_number] <= Checkpoint)) RETURN IF(HASONEVALUE(DimSimulation[simulation]) && HASONEVALUE(DimPopulation[population]), CALCULATE(SUM(FactExperimentPath[closing_members]), FactExperimentPath[month] = LastMonth, FILTER(ALL(DimGym), SWITCH(TRUE(), SELECTEDVALUE(DimPopulation[population]) = "All assigned pairs", DimGym[experiment_assignment] IN {"Treatment", "Control"}, SELECTEDVALUE(DimPopulation[population]) = "First repricing", DimGym[experiment_population] = "First repricing", SELECTEDVALUE(DimPopulation[population]) = "Repeat repricing", DimGym[experiment_population] = "Repeat repricing", LEFT(SELECTEDVALUE(DimPopulation[population]),7) = "Region:", DimGym[region] = TRIM(MID(SELECTEDVALUE(DimPopulation[population]),8,100)) && DimGym[experiment_assignment] IN {"Treatment", "Control"}, FALSE())), KEEPFILTERS(DimExperimentMonth[month_number] <= Checkpoint)))

[Experiment Monitoring In Population] =
VAR Population = SELECTEDVALUE(DimPopulation[population]) VAR RowPopulation = SELECTEDVALUE(FactExperimentMonitoring[population]) RETURN IF(Population = "All assigned pairs" || Population = RowPopulation, 1, IF(LEFT(Population,7) = "Region:", IF(LOOKUPVALUE(DimGym[region], DimGym[gym_id], SELECTEDVALUE(FactExperimentMonitoring[gym_id])) = TRIM(MID(Population,8,100)), 1, 0), 0))

[Experiment Pair In Population] =
VAR Population = SELECTEDVALUE(DimPopulation[population]) VAR RowPopulation = SELECTEDVALUE(FactExperimentPair[population]) RETURN IF(Population = "All assigned pairs" || Population = RowPopulation, 1, IF(LEFT(Population,7) = "Region:", IF(SELECTEDVALUE(FactExperimentPair[region]) = TRIM(MID(Population,8,100)), 1, 0), 0))

[Recommended Standard Price] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[proposed_standard_price]))

[Provisional Test Price] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[provisional_test_price]))

[Gyms In Selection] =
COUNTROWS(VALUES(DimGym[gym_id]))

[Median Standard Price] =
MEDIAN(DimGym[current_standard_price])

[Average Competitor Gap] =
AVERAGE(DimGym[competitor_price_gap])

[Caution Sites] =
COALESCE(COUNTROWS(FILTER(DimGym, DimGym[caution_flag_count] > 0)), 0)

[Headroom Churn 2025] =
SELECTEDVALUE(FactHeadroom[churn_rate_2025])

[Headroom Peak 2025] =
SELECTEDVALUE(FactHeadroom[average_monthly_peak_2025])

[Guardrail Point] =
IF([Experiment Evidence Current] && HASONEVALUE(DimSimulation[simulation]) && HASONEVALUE(DimPopulation[population]) && HASONEVALUE(DimCheckpoint[checkpoint_months]), SELECTEDVALUE(FactExperimentGuardrail[estimate]))

[Guardrail Point Display] =
VAR DisplayAmount = [Guardrail Point] RETURN IF(NOT ISBLANK(DisplayAmount), IF(CONTAINSSTRING(SELECTEDVALUE(FactExperimentGuardrail[metric]), "_pp"), FORMAT(DisplayAmount,"0.00") & " pp", FORMAT(DisplayAmount,"0.00%")), "Unavailable")

[Guardrail Lower] =
IF([Experiment Evidence Current] && HASONEVALUE(DimSimulation[simulation]) && HASONEVALUE(DimPopulation[population]) && HASONEVALUE(DimCheckpoint[checkpoint_months]), SELECTEDVALUE(FactExperimentGuardrail[lower]))

[Guardrail Lower Display] =
VAR DisplayAmount = [Guardrail Lower] RETURN IF(NOT ISBLANK(DisplayAmount), IF(CONTAINSSTRING(SELECTEDVALUE(FactExperimentGuardrail[metric]), "_pp"), FORMAT(DisplayAmount,"0.00") & " pp", FORMAT(DisplayAmount,"0.00%")), "Unavailable")

[Guardrail Upper] =
IF([Experiment Evidence Current] && HASONEVALUE(DimSimulation[simulation]) && HASONEVALUE(DimPopulation[population]) && HASONEVALUE(DimCheckpoint[checkpoint_months]), SELECTEDVALUE(FactExperimentGuardrail[upper]))

[Guardrail Upper Display] =
VAR DisplayAmount = [Guardrail Upper] RETURN IF(NOT ISBLANK(DisplayAmount), IF(CONTAINSSTRING(SELECTEDVALUE(FactExperimentGuardrail[metric]), "_pp"), FORMAT(DisplayAmount,"0.00") & " pp", FORMAT(DisplayAmount,"0.00%")), "Unavailable")

[Guardrail Tolerance] =
IF([Experiment Evidence Current] && HASONEVALUE(DimSimulation[simulation]) && HASONEVALUE(DimPopulation[population]) && HASONEVALUE(DimCheckpoint[checkpoint_months]), SELECTEDVALUE(FactExperimentGuardrail[tolerance]))

[Guardrail Tolerance Display] =
VAR DisplayAmount = [Guardrail Tolerance] RETURN IF(NOT ISBLANK(DisplayAmount), IF(CONTAINSSTRING(SELECTEDVALUE(FactExperimentGuardrail[metric]), "_pp"), FORMAT(DisplayAmount,"0.00") & " pp", FORMAT(DisplayAmount,"0.00%")), "Unavailable")

[Guardrail Upper Pass] =
IF([Experiment Evidence Current] && HASONEVALUE(DimSimulation[simulation]) && HASONEVALUE(DimPopulation[population]) && HASONEVALUE(DimCheckpoint[checkpoint_months]), IF(ISBLANK([Guardrail Upper]), "Uncertainty unavailable", IF([Guardrail Upper] <= [Guardrail Tolerance], "PASS", "Upper bound exceeds limit")))

[Experiment Pair Revenue Effect] =
VAR LogEffect = SELECTEDVALUE(FactExperimentPair[revenue_log]) RETURN IF([Experiment Evidence Current] && HASONEVALUE(DimSimulation[simulation]) && HASONEVALUE(DimCheckpoint[checkpoint_months]) && NOT ISBLANK(LogEffect), EXP(LogEffect) - 1)

