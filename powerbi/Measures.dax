IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]) && HASONEVALUE(DimCase[case]), SUM(FactPortfolioSite[member_difference]))

[Portfolio Joins] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]) && HASONEVALUE(DimCase[case]), SUM(FactPortfolioSite[new_members]))

[Portfolio Prospects] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]) && HASONEVALUE(DimCase[case]), SUM(FactPortfolioSite[qualified_prospects]))

[Portfolio Opening Exposure] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]) && HASONEVALUE(DimCase[case]), SUM(FactPortfolioSite[opening_members]))

[Portfolio Exits] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]) && HASONEVALUE(DimCase[case]), SUM(FactPortfolioSite[opening_base_cancellations]))

[Portfolio Average Exposure] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]) && HASONEVALUE(DimCase[case]), SUM(FactPortfolioSite[average_members]))

[Portfolio Subscription] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]) && HASONEVALUE(DimCase[case]), SUM(FactPortfolioSite[subscription_revenue]))

[Portfolio Incumbent Exposure] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]) && HASONEVALUE(DimCase[case]), SUM(FactPortfolioSite[incumbent_standard_opening]))

[Portfolio Incumbent Exits] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]) && HASONEVALUE(DimCase[case]), SUM(FactPortfolioSite[incumbent_standard_cancellations]))

[Portfolio Downgrades] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]) && HASONEVALUE(DimCase[case]), SUM(FactPortfolioSite[incumbent_standard_downgrades]))

[Portfolio Churn] =
DIVIDE([Portfolio Exits], [Portfolio Opening Exposure])

[Portfolio Conversion] =
DIVIDE([Portfolio Joins], [Portfolio Prospects])

[Portfolio ARPMM] =
DIVIDE([Portfolio Revenue], [Portfolio Average Exposure])

[Portfolio Downgrade Rate] =
DIVIDE([Portfolio Downgrades], [Portfolio Incumbent Exposure])

[Portfolio Increment lower] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]) && HASONEVALUE(DimCase[case]) && [Full Estate Scope], SELECTEDVALUE(FactPortfolio[incremental_revenue_lower]))

