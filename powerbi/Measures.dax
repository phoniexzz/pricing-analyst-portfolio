[Experiment Profile Churn] =
DIVIDE([Experiment Profile Incumbent Exits], [Experiment Profile Incumbent Exposure])

[Experiment Profile Downgrade Rate] =
DIVIDE([Experiment Profile Downgrades], [Experiment Profile Incumbent Exposure])

[Planning Power] =
SELECTEDVALUE(FactPower[planning_power])

