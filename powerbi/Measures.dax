// Documentation mirror; authoritative expressions are in TMDL.

[Forward Evidence Current] =
SELECTEDVALUE(EvidenceStatus[forward_current], FALSE())

[Experiment Evidence Current] =
SELECTEDVALUE(EvidenceStatus[experiment_current], FALSE())

[Evidence Status] =
SELECTEDVALUE(EvidenceStatus[evidence_message])

[Snapshot Version] =
SELECTEDVALUE(EvidenceStatus[snapshot_id])

[Snapshot Stamp] =
"Validated snapshot " & SELECTEDVALUE(EvidenceStatus[snapshot_id]) & "  |  " & SELECTEDVALUE(EvidenceStatus[validation_utc]) & "  |  Native verification pending"

[Full Estate Scope] =
COUNTROWS(VALUES(DimGym[gym_id])) = COUNTROWS(ALL(DimGym))

[Uncertainty Scope] =
IF([Full Estate Scope], "Saved complete-estate conditional parameter range", IF(HASONEVALUE(DimGym[gym_id]), "Saved individual-gym conditional parameter range", "Range unavailable for selected gyms or region. Site interval endpoints cannot be added."))

[Historical Window] =
FORMAT(MIN(DimHistoryMonth[month]), "mmm yyyy") & "–" & FORMAT(MAX(DimHistoryMonth[month]), "mmm yyyy")

[Net Revenue] =
SUM(FactHistory[monthly_revenue])

[Subscription Revenue] =
SUM(FactHistory[subscription_revenue])

[Joining Fee Revenue] =
SUM(FactHistory[joining_fee_revenue])

[Ancillary Revenue] =
SUM(FactHistory[ancillary_revenue])

[Average Member Months] =
SUM(FactHistory[average_members])

[Opening Member Months] =
SUM(FactHistory[opening_members])

[Acquisitions] =
SUM(FactHistory[new_members])

[Opening-base Exits] =
SUM(FactHistory[opening_base_cancellations])

[Same-month Exits] =
SUM(FactHistory[same_month_cancellations])

[Qualified Prospects] =
SUM(FactHistory[qualified_prospects])

[Complaints] =
SUM(FactHistory[pricing_complaints])

[Marketing Spend] =
SUM(FactHistory[marketing_spend])

[Standard Subscription Revenue] =
SUM(FactHistory[standard_subscription_revenue])

[Standard Member Months] =
SUM(FactHistory[average_standard_members])

[ARPMM] =
DIVIDE([Net Revenue], [Average Member Months])

[Subscription Yield] =
DIVIDE([Subscription Revenue], [Average Member Months])

[Standard Yield] =
DIVIDE([Standard Subscription Revenue], [Standard Member Months])

[Opening-base Churn] =
DIVIDE([Opening-base Exits], [Opening Member Months])

[Acquisition Rate] =
DIVIDE([Acquisitions], [Opening Member Months])

[Qualified Conversion] =
DIVIDE([Acquisitions], [Qualified Prospects])

[Complaints per 1000] =
DIVIDE([Complaints], [Average Member Months]) * 1000

[Monthly Retention] =
IF(NOT ISBLANK([Opening-base Churn]), 1 - [Opening-base Churn])

[Observed Months] =
DISTINCTCOUNT(FactHistory[month])

[Average Members] =
DIVIDE([Average Member Months], [Observed Months])

[Average Monthly Revenue] =
DIVIDE([Net Revenue], [Observed Months])

[Average Monthly Acquisitions] =
DIVIDE([Acquisitions], [Observed Months])

[Closing Members] =
VAR LastMonth = MAX(FactHistory[month]) RETURN CALCULATE(SUM(FactHistory[closing_members]), KEEPFILTERS(FactHistory[month] = LastMonth))

[Period Opening Members] =
VAR FirstMonth = MIN(FactHistory[month]) RETURN CALCULATE(SUM(FactHistory[opening_members]), KEEPFILTERS(FactHistory[month] = FirstMonth))

[Period Member Growth] =
DIVIDE([Closing Members] - [Period Opening Members], [Period Opening Members])

[Average Occupancy] =
DIVIDE(SUMX(FactHistory, FactHistory[utilisation_pct] * FactHistory[opening_minutes]), SUM(FactHistory[opening_minutes]))

[Average Monthly Peak] =
AVERAGEX(VALUES(FactHistory[month]), CALCULATE(AVERAGE(FactHistory[peak_utilisation_pct])))

[Maximum Monthly Peak] =
MAX(FactHistory[peak_utilisation_pct])

[Promotion Frequency] =
DIVIDE(COALESCE(COUNTROWS(FILTER(FactHistory, FactHistory[promotion_active] = TRUE())), 0), COUNTROWS(FactHistory))

[Standard Mix] =
DIVIDE(SUM(FactHistory[average_standard_members]), [Average Member Months])

[Off-Peak Mix] =
DIVIDE(SUM(FactHistory[average_offpeak_members]), [Average Member Months])

[Plus Mix] =
DIVIDE(SUM(FactHistory[average_premium_members]), [Average Member Months])

[Net Revenue Prior Year] =
VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Net Revenue], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))

[Closing Members Prior Year] =
VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Closing Members], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))

[Average Members Prior Year] =
VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Average Members], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))

[Average Member Months Prior Year] =
VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Average Member Months], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))

[ARPMM Prior Year] =
VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([ARPMM], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))

[Acquisitions Prior Year] =
VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Acquisitions], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))

[Qualified Conversion Prior Year] =
VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Qualified Conversion], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))

[Opening-base Churn Prior Year] =
VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Opening-base Churn], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))

[Monthly Retention Prior Year] =
VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Monthly Retention], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))

[Net Revenue YoY] =
VAR Previous = [Net Revenue Prior Year] RETURN IF(NOT ISBLANK(Previous) && Previous <> 0, DIVIDE([Net Revenue] - Previous, Previous))

[Closing Members YoY] =
VAR Previous = [Closing Members Prior Year] RETURN IF(NOT ISBLANK(Previous) && Previous <> 0, DIVIDE([Closing Members] - Previous, Previous))

[Average Members YoY] =
VAR Previous = [Average Members Prior Year] RETURN IF(NOT ISBLANK(Previous) && Previous <> 0, DIVIDE([Average Members] - Previous, Previous))

[Acquisitions YoY] =
VAR Previous = [Acquisitions Prior Year] RETURN IF(NOT ISBLANK(Previous) && Previous <> 0, DIVIDE([Acquisitions] - Previous, Previous))

[ARPMM YoY] =
VAR Previous = [ARPMM Prior Year] RETURN IF(NOT ISBLANK(Previous) && Previous <> 0, DIVIDE([ARPMM] - Previous, Previous))

[Qualified Conversion Change pp] =
VAR Previous = [Qualified Conversion Prior Year] RETURN IF(NOT ISBLANK(Previous) && NOT ISBLANK([Qualified Conversion]), ([Qualified Conversion] - Previous) * 100)

[Opening-base Churn Change pp] =
VAR Previous = [Opening-base Churn Prior Year] RETURN IF(NOT ISBLANK(Previous) && NOT ISBLANK([Opening-base Churn]), ([Opening-base Churn] - Previous) * 100)

[Monthly Retention Change pp] =
VAR Previous = [Monthly Retention Prior Year] RETURN IF(NOT ISBLANK(Previous) && NOT ISBLANK([Monthly Retention]), ([Monthly Retention] - Previous) * 100)

[Executive Revenue Comparison] =
VAR Change = [Net Revenue YoY] RETURN IF(ISBLANK(Change), "Prior period unavailable", "vs " & FORMAT(MAX(DimHistoryMonth[year])-1,"0") & ": " & FORMAT(Change,"+0.00%;−0.00%;0.00%"))

[Executive Members Comparison] =
VAR Change = [Closing Members YoY] RETURN IF(ISBLANK(Change), "Prior period unavailable", "vs " & FORMAT(MAX(DimHistoryMonth[year])-1,"0") & ": " & FORMAT(Change,"+0.00%;−0.00%;0.00%"))

[Executive ARPMM Comparison] =
VAR Change = [ARPMM YoY] RETURN IF(ISBLANK(Change), "Prior period unavailable", "vs " & FORMAT(MAX(DimHistoryMonth[year])-1,"0") & ": " & FORMAT(Change,"+0.00%;−0.00%;0.00%"))

[Executive Acquisition Comparison] =
VAR Change = [Acquisitions YoY] RETURN IF(ISBLANK(Change), "Prior period unavailable", "vs " & FORMAT(MAX(DimHistoryMonth[year])-1,"0") & ": " & FORMAT(Change,"+0.00%;−0.00%;0.00%"))

[Executive Churn Comparison] =
VAR Change = [Opening-base Churn Change pp] RETURN IF(ISBLANK(Change), "Prior period unavailable", "vs " & FORMAT(MAX(DimHistoryMonth[year])-1,"0") & ": " & FORMAT(Change,"+0.00;−0.00;0.00") & " pp")

[Q4 Net Revenue] =
CALCULATE([Net Revenue], REMOVEFILTERS(DimHistoryMonth), DimHistoryMonth[year] = 2025, DimHistoryMonth[quarter] = "Q4")

[Q4 Net Revenue 2024] =
CALCULATE([Net Revenue], REMOVEFILTERS(DimHistoryMonth), DimHistoryMonth[year] = 2024, DimHistoryMonth[quarter] = "Q4")

[Q4 Net Revenue Growth] =
VAR Previous = [Q4 Net Revenue 2024] RETURN DIVIDE([Q4 Net Revenue] - Previous, Previous)

[Q4 Acquisitions] =
CALCULATE([Acquisitions], REMOVEFILTERS(DimHistoryMonth), DimHistoryMonth[year] = 2025, DimHistoryMonth[quarter] = "Q4")

[Q4 Acquisitions 2024] =
CALCULATE([Acquisitions], REMOVEFILTERS(DimHistoryMonth), DimHistoryMonth[year] = 2024, DimHistoryMonth[quarter] = "Q4")

[Q4 Acquisitions Growth] =
VAR Previous = [Q4 Acquisitions 2024] RETURN DIVIDE([Q4 Acquisitions] - Previous, Previous)

[Q4 Qualified Conversion] =
CALCULATE([Qualified Conversion], REMOVEFILTERS(DimHistoryMonth), DimHistoryMonth[year] = 2025, DimHistoryMonth[quarter] = "Q4")

[Q4 Qualified Conversion 2024] =
CALCULATE([Qualified Conversion], REMOVEFILTERS(DimHistoryMonth), DimHistoryMonth[year] = 2024, DimHistoryMonth[quarter] = "Q4")

[Q4 Qualified Conversion Change pp] =
VAR Previous = [Q4 Qualified Conversion 2024] RETURN IF(NOT ISBLANK(Previous), ([Q4 Qualified Conversion] - Previous) * 100)

[Q4 Opening-base Churn] =
CALCULATE([Opening-base Churn], REMOVEFILTERS(DimHistoryMonth), DimHistoryMonth[year] = 2025, DimHistoryMonth[quarter] = "Q4")

[Q4 Opening-base Churn 2024] =
CALCULATE([Opening-base Churn], REMOVEFILTERS(DimHistoryMonth), DimHistoryMonth[year] = 2024, DimHistoryMonth[quarter] = "Q4")

[Q4 Opening-base Churn Change pp] =
VAR Previous = [Q4 Opening-base Churn 2024] RETURN IF(NOT ISBLANK(Previous), ([Q4 Opening-base Churn] - Previous) * 100)

[Volume Bridge] =
IF(NOT ISBLANK([Net Revenue Prior Year]), ([Average Member Months] - [Average Member Months Prior Year]) * [ARPMM Prior Year])

[ARPMM Bridge] =
IF(NOT ISBLANK([Net Revenue Prior Year]), [Average Member Months] * ([ARPMM] - [ARPMM Prior Year]))

[Revenue Bridge] =
SWITCH(SELECTEDVALUE(DimBridge[step]), "2024 revenue", [Net Revenue Prior Year], "Member volume", [Volume Bridge], "Total ARPMM", [ARPMM Bridge], "2025 revenue", [Net Revenue])

[December Exit Run-rate] =
CALCULATE([Net Revenue], REMOVEFILTERS(DimHistoryMonth), DimHistoryMonth[month] = DATE(2025,12,1)) * 12

[Standard Headline December] =
SELECTEDVALUE(DimGym[current_standard_price])

[Off-Peak Headline December] =
SELECTEDVALUE(DimGym[current_offpeak_price])

[Plus Headline December] =
SELECTEDVALUE(DimGym[current_premium_price])

[Competitor Recurring December] =
SELECTEDVALUE(DimGym[local_competitor_avg_price])

[Competitor Gap December] =
SELECTEDVALUE(DimGym[competitor_price_gap])

[Headroom Score] =
SELECTEDVALUE(DimGym[score])

[Saved Estate Rank] =
SELECTEDVALUE(DimGym[rank])

[December Competitor Count] =
SELECTEDVALUE(DimGym[competitor_count_3km])

[Headroom Band] =
SELECTEDVALUE(DimGym[band])

[Headroom Segment] =
SELECTEDVALUE(DimGym[segment])

[Caution Count] =
SELECTEDVALUE(FactHeadroom[caution_flag_count])

[Pricing Complaints 2025] =
SELECTEDVALUE(FactHeadroom[complaints_per_1000_member_months_2025])

[Competitor Joining Fee December] =
SELECTEDVALUE(FactHeadroom[competitor_mean_joining_fee_dec2025])

[Competitor Intro Discount December] =
SELECTEDVALUE(FactHeadroom[competitor_mean_first_month_discount_dec2025])

[Rank Movement Sensitivity] =
SELECTEDVALUE(FactHeadroom[max_absolute_rank_movement])

[Saved Recommendation] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[action]), "UNAVAILABLE — refresh evidence")

[Recommended Increment] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[proposed_increment]))

[Provisional Test Increment] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[provisional_test_increment]))

[Recommendation Explanation] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[explanation]), [Evidence Status])

[Recommendation Site Count] =
IF([Forward Evidence Current], COALESCE(COUNTROWS(FactRecommendation), 0))

[Conditional Raise Sites] =
IF([Forward Evidence Current], COALESCE(CALCULATE(COUNTROWS(FactRecommendation), FactRecommendation[action] IN {"RAISE £1", "RAISE £2"}), 0))

[Saved Policy Action] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]), SELECTEDVALUE(FactPolicyRecommendation[action]))

[Saved Policy Amount] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]), SELECTEDVALUE(FactPolicyRecommendation[proposed_increment]))

[£1 plausible] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus1_plausible]))

[£1 qualified] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus1_qualified]))

[£1 failed gates] =
IF([Forward Evidence Current] && HASONEVALUE(DimGym[gym_id]), IF(SELECTEDVALUE(FactRecommendation[plus1_complete]) = TRUE(), COALESCE(SELECTEDVALUE(FactRecommendation[plus1_failed_gates]), "None"), "Unavailable required evidence"))

[£1 base revenue] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus1_base_revenue]))

[£1 downside revenue] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus1_downside_revenue]))

[£1 downside member impact] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus1_downside_member_impact]))

[£1 revenue lower] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus1_revenue_lower]))

[£1 revenue upper] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus1_revenue_upper]))

[£1 post competitor gap] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus1_post_competitor_gap]))

[£1 worst sensitivity revenue] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus1_worst_sensitivity_revenue]))

[£2 plausible] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus2_plausible]))

[£2 qualified] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus2_qualified]))

[£2 failed gates] =
IF([Forward Evidence Current] && HASONEVALUE(DimGym[gym_id]), IF(SELECTEDVALUE(FactRecommendation[plus2_complete]) = TRUE(), COALESCE(SELECTEDVALUE(FactRecommendation[plus2_failed_gates]), "None"), "Unavailable required evidence"))

[£2 base revenue] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus2_base_revenue]))

[£2 downside revenue] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus2_downside_revenue]))

[£2 downside member impact] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus2_downside_member_impact]))

[£2 revenue lower] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus2_revenue_lower]))

[£2 revenue upper] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus2_revenue_upper]))

[£2 post competitor gap] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus2_post_competitor_gap]))

[£2 worst sensitivity revenue] =
IF([Forward Evidence Current], SELECTEDVALUE(FactRecommendation[plus2_worst_sensitivity_revenue]))

[Scenario Revenue] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[monthly_revenue]))

[Scenario Subscription] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[subscription_revenue]))

[Scenario Joining Fees] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[joining_fee_revenue]))

[Scenario Ancillary] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[ancillary_revenue]))

[Scenario Incremental Revenue] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[incremental_revenue]))

[Scenario December Members] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[month12_members]))

[Scenario Member Difference] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[member_difference]))

[Scenario Joins] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[new_members]))

[Scenario Standard Joins] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[standard_joins]))

[Scenario Prospects] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[qualified_prospects]))

[Scenario Opening Exposure] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[opening_members]))

[Scenario Average Exposure] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[average_members]))

[Scenario Opening Exits] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[opening_base_cancellations]))

[Scenario Incumbent Exposure] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[incumbent_standard_opening]))

[Scenario Incumbent Exits] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[incumbent_standard_cancellations]))

[Scenario Downgrades] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[incumbent_standard_downgrades]))

[Scenario Exit Run-rate] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[annualised_exit_run_rate]))

[Scenario Standard Revenue] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[standard_subscription_revenue]))

[Scenario Standard Exposure] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), SUM(FactScenarioAnnual[standard_average_members]))

[Scenario ARPMM] =
DIVIDE([Scenario Revenue], [Scenario Average Exposure])

[Scenario Subscription Yield] =
DIVIDE([Scenario Subscription], [Scenario Average Exposure])

[Scenario Standard Yield] =
DIVIDE([Scenario Standard Revenue], [Scenario Standard Exposure])

[Scenario Conversion] =
DIVIDE([Scenario Joins], [Scenario Prospects])

[Scenario Churn] =
DIVIDE([Scenario Opening Exits], [Scenario Opening Exposure])

[Scenario Incumbent Churn] =
DIVIDE([Scenario Incumbent Exits], [Scenario Incumbent Exposure])

[Scenario Downgrade Rate] =
DIVIDE([Scenario Downgrades], [Scenario Incumbent Exposure])

[Scenario Member Impact] =
DIVIDE([Scenario Member Difference], CALCULATE([Scenario December Members], REMOVEFILTERS(DimPrice), DimPrice[price_increment] = 0))

[Scenario Monthly Revenue] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]) && HASONEVALUE(DimScenarioMonth[month]), SUM(FactScenarioMonthly[monthly_revenue]))

[Scenario Monthly Closing] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]) && HASONEVALUE(DimScenarioMonth[month]), SUM(FactScenarioMonthly[closing_members]))

[Scenario Cumulative Increment] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]) && HASONEVALUE(DimScenarioMonth[month]), SUM(FactScenarioMonthly[cumulative_incremental_revenue]))

[Scenario Increment lower] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), IF(HASONEVALUE(DimGym[gym_id]), SELECTEDVALUE(FactScenarioAnnual[incremental_revenue_lower]), IF([Full Estate Scope], SELECTEDVALUE(FactScenarioEstate[incremental_revenue_lower]))))

[Scenario Members lower] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), IF(HASONEVALUE(DimGym[gym_id]), SELECTEDVALUE(FactScenarioAnnual[month12_members_lower]), IF([Full Estate Scope], SELECTEDVALUE(FactScenarioEstate[month12_members_lower]))))

[Scenario Increment upper] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), IF(HASONEVALUE(DimGym[gym_id]), SELECTEDVALUE(FactScenarioAnnual[incremental_revenue_upper]), IF([Full Estate Scope], SELECTEDVALUE(FactScenarioEstate[incremental_revenue_upper]))))

[Scenario Members upper] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), IF(HASONEVALUE(DimGym[gym_id]), SELECTEDVALUE(FactScenarioAnnual[month12_members_upper]), IF([Full Estate Scope], SELECTEDVALUE(FactScenarioEstate[month12_members_upper]))))

[Positive Draw Fraction] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]), IF(HASONEVALUE(DimGym[gym_id]), SELECTEDVALUE(FactScenarioAnnual[positive_revenue_draw_fraction]), IF([Full Estate Scope], SELECTEDVALUE(FactScenarioEstate[positive_revenue_draw_fraction]))))

[Break-even Multiplier] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]) && HASONEVALUE(DimGym[gym_id]), SELECTEDVALUE(FactScenarioAnnual[break_even_response_multiplier]))

[Break-even Member Impact] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]) && HASONEVALUE(DimGym[gym_id]), SELECTEDVALUE(FactScenarioAnnual[break_even_member_impact]))

[Break-even Crossings] =
IF([Forward Evidence Current] && HASONEVALUE(DimCase[case]) && HASONEVALUE(DimPrice[price_increment]) && HASONEVALUE(DimGym[gym_id]), SELECTEDVALUE(FactScenarioAnnual[break_even_crossings]))

[Teaching Retention Ratio] =
