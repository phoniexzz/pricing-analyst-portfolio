[Base Portfolio Increment] =
CALCULATE([Portfolio Increment], REMOVEFILTERS(DimPolicy), DimPolicy[variant] = "base")

[Base Portfolio Member Difference] =
CALCULATE([Portfolio Member Difference], REMOVEFILTERS(DimPolicy), DimPolicy[variant] = "base")

[Base Portfolio Increment lower] =
CALCULATE([Portfolio Increment lower], REMOVEFILTERS(DimPolicy), DimPolicy[variant] = "base")

[Saved Policy Raise £1 Sites] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]), COALESCE(CALCULATE(COUNTROWS(FactPolicyRecommendation), FactPolicyRecommendation[action] = "RAISE £1"), 0))

[Saved Policy Raise £2 Sites] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]), COALESCE(CALCULATE(COUNTROWS(FactPolicyRecommendation), FactPolicyRecommendation[action] = "RAISE £2"), 0))

[Saved Policy Test Sites] =
IF([Forward Evidence Current] && HASONEVALUE(DimPolicy[variant]), COALESCE(CALCULATE(COUNTROWS(FactPolicyRecommendation), FactPolicyRecommendation[action] = "TEST FIRST"), 0))

[Historical Reporting Note] =
"Historical window: " & [Historical Window] & ". Prior year uses the same months; incomplete comparisons are unavailable. Pricing snapshots are December 2025; conditional portfolio is Jan–Dec 2026."

[Experiment Profile Revenue] =
VAR Checkpoint = SELECTEDVALUE(DimCheckpoint[checkpoint_months],6) VAR Month = SELECTEDVALUE(DimExperimentMonth[month]) VAR PreStart = EDATE(DATE(2026,1,1),-Checkpoint) RETURN IF([Experiment Evidence Current] && HASONEVALUE(DimSimulation[simulation]) && HASONEVALUE(DimPopulation[population]) && NOT ISBLANK(Month), IF(Month >= PreStart && Month < DATE(2026,1,1), CALCULATE(SUM(FactExperimentHistory[monthly_revenue]), FILTER(ALL(DimGym), SWITCH(TRUE(), SELECTEDVALUE(DimPopulation[population]) = "All assigned pairs", DimGym[experiment_assignment] IN {"Treatment", "Control"}, SELECTEDVALUE(DimPopulation[population]) = "First repricing", DimGym[experiment_population] = "First repricing", SELECTEDVALUE(DimPopulation[population]) = "Repeat repricing", DimGym[experiment_population] = "Repeat repricing", LEFT(SELECTEDVALUE(DimPopulation[population]),7) = "Region:", DimGym[region] = TRIM(MID(SELECTEDVALUE(DimPopulation[population]),8,100)) && DimGym[experiment_assignment] IN {"Treatment", "Control"}, FALSE()))), IF(Month >= DATE(2026,1,1) && Month <= DATE(2026,Checkpoint,1), CALCULATE(SUM(FactExperimentPath[monthly_revenue]), FILTER(ALL(DimGym), SWITCH(TRUE(), SELECTEDVALUE(DimPopulation[population]) = "All assigned pairs", DimGym[experiment_assignment] IN {"Treatment", "Control"}, SELECTEDVALUE(DimPopulation[population]) = "First repricing", DimGym[experiment_population] = "First repricing", SELECTEDVALUE(DimPopulation[population]) = "Repeat repricing", DimGym[experiment_population] = "Repeat repricing", LEFT(SELECTEDVALUE(DimPopulation[population]),7) = "Region:", DimGym[region] = TRIM(MID(SELECTEDVALUE(DimPopulation[population]),8,100)) && DimGym[experiment_assignment] IN {"Treatment", "Control"}, FALSE()))))))

[Experiment Profile Incumbent Exposure] =
VAR Checkpoint = SELECTEDVALUE(DimCheckpoint[checkpoint_months],6) VAR Month = SELECTEDVALUE(DimExperimentMonth[month]) VAR PreStart = EDATE(DATE(2026,1,1),-Checkpoint) RETURN IF([Experiment Evidence Current] && HASONEVALUE(DimSimulation[simulation]) && HASONEVALUE(DimPopulation[population]) && NOT ISBLANK(Month), IF(Month >= PreStart && Month < DATE(2026,1,1), CALCULATE(SUM(FactExperimentHistory[incumbent_standard_opening]), FILTER(ALL(DimGym), SWITCH(TRUE(), SELECTEDVALUE(DimPopulation[population]) = "All assigned pairs", DimGym[experiment_assignment] IN {"Treatment", "Control"}, SELECTEDVALUE(DimPopulation[population]) = "First repricing", DimGym[experiment_population] = "First repricing", SELECTEDVALUE(DimPopulation[population]) = "Repeat repricing", DimGym[experiment_population] = "Repeat repricing", LEFT(SELECTEDVALUE(DimPopulation[population]),7) = "Region:", DimGym[region] = TRIM(MID(SELECTEDVALUE(DimPopulation[population]),8,100)) && DimGym[experiment_assignment] IN {"Treatment", "Control"}, FALSE()))), IF(Month >= DATE(2026,1,1) && Month <= DATE(2026,Checkpoint,1), CALCULATE(SUM(FactExperimentPath[incumbent_standard_opening]), FILTER(ALL(DimGym), SWITCH(TRUE(), SELECTEDVALUE(DimPopulation[population]) = "All assigned pairs", DimGym[experiment_assignment] IN {"Treatment", "Control"}, SELECTEDVALUE(DimPopulation[population]) = "First repricing", DimGym[experiment_population] = "First repricing", SELECTEDVALUE(DimPopulation[population]) = "Repeat repricing", DimGym[experiment_population] = "Repeat repricing", LEFT(SELECTEDVALUE(DimPopulation[population]),7) = "Region:", DimGym[region] = TRIM(MID(SELECTEDVALUE(DimPopulation[population]),8,100)) && DimGym[experiment_assignment] IN {"Treatment", "Control"}, FALSE()))))))

