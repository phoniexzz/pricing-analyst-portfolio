	/// Volume Bridge
	measure 'Volume Bridge' = IF(NOT ISBLANK([Net Revenue Prior Year]), ([Average Member Months] - [Average Member Months Prior Year]) * [ARPMM Prior Year])
		formatString: £#,##0;−£#,##0;£0
		displayFolder: Historical Bridge
