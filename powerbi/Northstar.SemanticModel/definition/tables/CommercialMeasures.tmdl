		formatString: #,##0
		displayFolder: Matching Period
		lineageTag: 8de63f7e-5e91-588f-9354-dae42a47b18e

	/// Average Member Months Prior Year
	measure 'Average Member Months Prior Year' = VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Average Member Months], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))
		formatString: #,##0
		displayFolder: Matching Period
		lineageTag: d7158144-4b80-502c-82b2-e8ca6ba73c20

	/// ARPMM Prior Year
	measure 'ARPMM Prior Year' = VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([ARPMM], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))
		formatString: £0.00
		displayFolder: Matching Period
		lineageTag: 4a858695-7e25-577e-8651-92e9afb78095

	/// Acquisitions Prior Year
	measure 'Acquisitions Prior Year' = VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Acquisitions], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))
