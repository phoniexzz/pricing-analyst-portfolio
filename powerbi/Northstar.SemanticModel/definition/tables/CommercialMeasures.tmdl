		lineageTag: 804e4819-c9e1-578d-999d-1a64b2e4ece8

	/// Qualified Conversion Prior Year
	measure 'Qualified Conversion Prior Year' = VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Qualified Conversion], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))
