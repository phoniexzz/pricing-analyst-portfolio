	/// Historical Reporting Note
	measure 'Historical Reporting Note' = "Historical window: " & [Historical Window] & ". Prior year uses the same months; incomplete comparisons are unavailable. Pricing snapshots are December 2025; conditional portfolio is Jan–Dec 2026."
		displayFolder: Historical
		lineageTag: 39a8661d-5865-5c39-8076-2d9078bf462b

	/// Common deduplicated pre-period actuals plus one saved simulated post path, for matching-length windows.
	measure 'Experiment Profile Revenue' = VAR Checkpoint = SELECTEDVALUE(DimCheckpoint[checkpoint_months],6) VAR Month = SELECTEDVALUE(DimExperimentMonth[month]) VAR PreStart = EDATE(DATE(2026,1,1),-Checkpoint) RETURN IF([Experiment Evidence Current] && HASONEVALUE(DimSimulation[simulation]) && HASONEVALUE(DimPopulation[population]) && NOT ISBLANK(Month), IF(Month >= PreStart && Month < DATE(2026,1,1), CALCULATE(SUM(FactExperimentHistory[monthly_revenue]), FILTER(ALL(DimGym), SWITCH(TRUE(), SELECTEDVALUE(DimPopulation[population]) = "All assigned pairs", DimGym[experiment_assignment] IN {"Treatment", "Control"}, SELECTEDVALUE(DimPopulation[population]) = "First repricing", DimGym[experiment_population] = "First repricing", SELECTEDVALUE(DimPopulation[population]) = "Repeat repricing", DimGym[experiment_population] = "Repeat repricing", LEFT(SELECTEDVALUE(DimPopulation[population]),7) = "Region:", DimGym[region] = TRIM(MID(SELECTEDVALUE(DimPopulation[population]),8,100)) && DimGym[experiment_assignment] IN {"Treatment", "Control"}, FALSE()))), IF(Month >= DATE(2026,1,1) && Month <= DATE(2026,Checkpoint,1), CALCULATE(SUM(FactExperimentPath[monthly_revenue]), FILTER(ALL(DimGym), SWITCH(TRUE(), SELECTEDVALUE(DimPopulation[population]) = "All assigned pairs", DimGym[experiment_assignment] IN {"Treatment", "Control"}, SELECTEDVALUE(DimPopulation[population]) = "First repricing", DimGym[experiment_population] = "First repricing", SELECTEDVALUE(DimPopulation[population]) = "Repeat repricing", DimGym[experiment_population] = "Repeat repricing", LEFT(SELECTEDVALUE(DimPopulation[population]),7) = "Region:", DimGym[region] = TRIM(MID(SELECTEDVALUE(DimPopulation[population]),8,100)) && DimGym[experiment_assignment] IN {"Treatment", "Control"}, FALSE()))))))
		formatString: £#,##0;−£#,##0;£0
		displayFolder: Experiment Profiles
		lineageTag: 113569b7-c1a2-5f74-b4fb-ea097349e8b7

