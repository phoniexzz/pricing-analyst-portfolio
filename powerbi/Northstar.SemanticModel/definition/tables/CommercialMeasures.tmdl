	/// Marketing Spend
	measure 'Marketing Spend' = SUM(FactHistory[marketing_spend])
		formatString: £#,##0;−£#,##0;£0
		displayFolder: Historical
		lineageTag: f47bff1a-c6fc-50c9-aedc-19cb6c6648ed

	/// Standard Subscription Revenue
	measure 'Standard Subscription Revenue' = SUM(FactHistory[standard_subscription_revenue])
		formatString: £#,##0;−£#,##0;£0
		displayFolder: Historical
		lineageTag: 07e92770-3fcd-5bde-91c9-6f2b3a5d66f3

	/// Standard Member Months
	measure 'Standard Member Months' = SUM(FactHistory[average_standard_members])
		formatString: #,##0
		displayFolder: Historical
		lineageTag: 07df740d-909e-5bdd-8b26-0a317e677596

	/// Net Revenue / Average Member Months; summed numerator and exposure; missing or zero denominator is blank.
	measure ARPMM = DIVIDE([Net Revenue], [Average Member Months])
		formatString: £0.00
		displayFolder: Historical
		lineageTag: ddf9d400-5129-5743-a8c1-aff248e21724

	/// Subscription Revenue / Average Member Months; summed numerator and exposure; missing or zero denominator is blank.
	measure 'Subscription Yield' = DIVIDE([Subscription Revenue], [Average Member Months])
		formatString: £0.00
		displayFolder: Historical
		lineageTag: 702589d1-2d7e-5391-8fbc-570b4ea57a79

	/// Standard Subscription Revenue / Standard Member Months; summed numerator and exposure; missing or zero denominator is blank.
	measure 'Standard Yield' = DIVIDE([Standard Subscription Revenue], [Standard Member Months])
		formatString: £0.00
		displayFolder: Historical
		lineageTag: 406ee764-ea7f-5320-abc9-159f432f9ae3

	/// Opening-base Exits / Opening Member Months; summed numerator and exposure; missing or zero denominator is blank.
	measure 'Opening-base Churn' = DIVIDE([Opening-base Exits], [Opening Member Months])
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Historical
		lineageTag: f64d1daa-8065-5449-898e-db41afffd72f

	/// Acquisitions / Opening Member Months; summed numerator and exposure; missing or zero denominator is blank.
	measure 'Acquisition Rate' = DIVIDE([Acquisitions], [Opening Member Months])
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Historical
		lineageTag: 7d7199aa-c2c1-58f6-98e2-561a2235451b

	/// Acquisitions / Qualified Prospects; summed numerator and exposure; missing or zero denominator is blank.
	measure 'Qualified Conversion' = DIVIDE([Acquisitions], [Qualified Prospects])
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Historical
		lineageTag: 3fb5a285-ee52-5cb6-bad0-fbad9a269765

	/// Complaints / Average Member Months; summed numerator and exposure; missing or zero denominator is blank.
	measure 'Complaints per 1000' = DIVIDE([Complaints], [Average Member Months]) * 1000
		formatString: 0.00
		displayFolder: Historical
		lineageTag: 676050de-2ae0-5295-bcb0-830635b1a856

	/// One minus monthly exposure-weighted opening-base churn. This is not annual retention.
	measure 'Monthly Retention' = IF(NOT ISBLANK([Opening-base Churn]), 1 - [Opening-base Churn])
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Historical
		lineageTag: 6950fa58-a835-5df9-b959-9e33f6210443

	/// Observed Months
	measure 'Observed Months' = DISTINCTCOUNT(FactHistory[month])
		formatString: #,##0
		displayFolder: Historical
		lineageTag: db6d07ec-67cc-5652-bcca-c69d3000eb93

	/// Average Members
	measure 'Average Members' = DIVIDE([Average Member Months], [Observed Months])
		formatString: #,##0
		displayFolder: Historical
		lineageTag: 944ef89f-8985-556b-81a0-3f7a9c924473

	/// Average Monthly Revenue
	measure 'Average Monthly Revenue' = DIVIDE([Net Revenue], [Observed Months])
		formatString: £#,##0;−£#,##0;£0
		displayFolder: Historical
		lineageTag: 98eb5301-dd02-5e61-baad-a6f654cf0b7f

	/// Average Monthly Acquisitions
	measure 'Average Monthly Acquisitions' = DIVIDE([Acquisitions], [Observed Months])
		formatString: #,##0
		displayFolder: Historical
		lineageTag: 276de21c-584d-5238-a946-d7892d3cc4cc

	/// Stock at final observed month, never sum monthly membership stocks.
	measure 'Closing Members' = VAR LastMonth = MAX(FactHistory[month]) RETURN CALCULATE(SUM(FactHistory[closing_members]), KEEPFILTERS(FactHistory[month] = LastMonth))
		formatString: #,##0
		displayFolder: Historical
		lineageTag: 888cdebe-bedc-586c-b21d-98479ccab4a4

	/// Period Opening Members
	measure 'Period Opening Members' = VAR FirstMonth = MIN(FactHistory[month]) RETURN CALCULATE(SUM(FactHistory[opening_members]), KEEPFILTERS(FactHistory[month] = FirstMonth))
		formatString: #,##0
		displayFolder: Historical
		lineageTag: e5920f1a-89e9-51a8-8ee4-4bdedeeb70cf

	/// Period Member Growth
	measure 'Period Member Growth' = DIVIDE([Closing Members] - [Period Opening Members], [Period Opening Members])
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Historical
		lineageTag: 1b1785f3-e8ea-5ee5-a3c9-db8504b25165

	/// Average Occupancy
	measure 'Average Occupancy' = DIVIDE(SUMX(FactHistory, FactHistory[utilisation_pct] * FactHistory[opening_minutes]), SUM(FactHistory[opening_minutes]))
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Historical
		lineageTag: c873de8b-a6aa-546a-ad35-9ed78c3a1cdc

	/// Average Monthly Peak
	measure 'Average Monthly Peak' = AVERAGEX(VALUES(FactHistory[month]), CALCULATE(AVERAGE(FactHistory[peak_utilisation_pct])))
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Historical
		lineageTag: 126f1431-47e2-5d63-a0a2-ee228955cc45

	/// Maximum Monthly Peak
	measure 'Maximum Monthly Peak' = MAX(FactHistory[peak_utilisation_pct])
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Historical
		lineageTag: 136c2868-4dec-5eca-8611-ec92e51ca352

	/// Promotion Frequency
	measure 'Promotion Frequency' = DIVIDE(COALESCE(COUNTROWS(FILTER(FactHistory, FactHistory[promotion_active] = TRUE())), 0), COUNTROWS(FactHistory))
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Historical
		lineageTag: 8f788469-3847-59a4-910c-39ecd2bc33e2

	/// Standard Mix
	measure 'Standard Mix' = DIVIDE(SUM(FactHistory[average_standard_members]), [Average Member Months])
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Historical
		lineageTag: 0565b31a-ed6e-5fc6-9bbf-2cc0d41e5427

	/// Off-Peak Mix
	measure 'Off-Peak Mix' = DIVIDE(SUM(FactHistory[average_offpeak_members]), [Average Member Months])
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Historical
		lineageTag: e1366c92-5b44-5286-be1a-b669064809f2

	/// Plus Mix
	measure 'Plus Mix' = DIVIDE(SUM(FactHistory[average_premium_members]), [Average Member Months])
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Historical
		lineageTag: db696026-ef0c-5368-ac56-1603a6184b7f

	/// Net Revenue Prior Year
	measure 'Net Revenue Prior Year' = VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Net Revenue], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))
		formatString: £#,##0;−£#,##0;£0
		displayFolder: Matching Period
		lineageTag: 4d9cb05d-c1ff-58b0-b28f-4e2d5efa9da1

	/// Closing Members Prior Year
	measure 'Closing Members Prior Year' = VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Closing Members], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))
		formatString: #,##0
