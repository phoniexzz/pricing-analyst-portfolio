table CommercialMeasures
	lineageTag: 5b5fb140-a666-5d1f-9138-4fc160658344

	/// Forward Evidence Current
	measure 'Forward Evidence Current' = SELECTEDVALUE(EvidenceStatus[forward_current], FALSE())
		displayFolder: Evidence
		lineageTag: 35484b41-6647-5884-bc4d-8d131f2edae1

	/// Experiment Evidence Current
	measure 'Experiment Evidence Current' = SELECTEDVALUE(EvidenceStatus[experiment_current], FALSE())
		displayFolder: Evidence
		lineageTag: fc9d175e-ab96-52ee-bf11-48e7dcb1cb9d

	/// Evidence Status
	measure 'Evidence Status' = SELECTEDVALUE(EvidenceStatus[evidence_message])
		displayFolder: Evidence
		lineageTag: 8bda14bf-4e30-5c6f-adc1-87dfe86b03ed

	/// Snapshot Version
	measure 'Snapshot Version' = SELECTEDVALUE(EvidenceStatus[snapshot_id])
		displayFolder: Evidence
		lineageTag: 990bc8be-dbd6-5619-b508-5da4fbd9f460

	/// Snapshot Stamp
	measure 'Snapshot Stamp' = "Validated snapshot " & SELECTEDVALUE(EvidenceStatus[snapshot_id]) & "  |  " & SELECTEDVALUE(EvidenceStatus[validation_utc]) & "  |  Native verification pending"
		displayFolder: Evidence
		lineageTag: d8eb6b51-c1cf-5109-aaa7-92c44c09f161

	/// Full saved estate scope only. A regional or arbitrary subset is unsupported for ranges.
	measure 'Full Estate Scope' = COUNTROWS(VALUES(DimGym[gym_id])) = COUNTROWS(ALL(DimGym))
		displayFolder: Evidence
		lineageTag: 52cfff90-6e73-541b-9049-2755923f8953

	/// Uncertainty Scope
	measure 'Uncertainty Scope' = IF([Full Estate Scope], "Saved complete-estate conditional parameter range", IF(HASONEVALUE(DimGym[gym_id]), "Saved individual-gym conditional parameter range", "Range unavailable for selected gyms or region. Site interval endpoints cannot be added."))
		displayFolder: Evidence
		lineageTag: 69a91a28-0dfe-553d-a7fc-36aef3c05861

	/// Historical Window
	measure 'Historical Window' = FORMAT(MIN(DimHistoryMonth[month]), "mmm yyyy") & "–" & FORMAT(MAX(DimHistoryMonth[month]), "mmm yyyy")
		displayFolder: Historical
		lineageTag: 88e1a7fe-c510-500b-b62c-5f573226872e

	/// Net Revenue
	measure 'Net Revenue' = SUM(FactHistory[monthly_revenue])
		formatString: £#,##0;−£#,##0;£0
