	/// Interaction allocated to ARPMM. ARPMM includes tier mix, joining fees and ancillary revenue, not solely price.
	measure 'ARPMM Bridge' = IF(NOT ISBLANK([Net Revenue Prior Year]), [Average Member Months] * ([ARPMM] - [ARPMM Prior Year]))
		formatString: £#,##0;−£#,##0;£0
		displayFolder: Historical Bridge
		lineageTag: c63cfd1d-93de-5fbd-82a6-b8b1e4840cdd

	/// Revenue Bridge
	measure 'Revenue Bridge' = SWITCH(SELECTEDVALUE(DimBridge[step]), "2024 revenue", [Net Revenue Prior Year], "Member volume", [Volume Bridge], "Total ARPMM", [ARPMM Bridge], "2025 revenue", [Net Revenue])
