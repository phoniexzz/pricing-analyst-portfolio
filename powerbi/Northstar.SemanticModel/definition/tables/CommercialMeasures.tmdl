		displayFolder: Matching Period
		lineageTag: 88692bce-63f9-538c-962b-7e372e428b89

	/// Opening-base Churn Prior Year
	measure 'Opening-base Churn Prior Year' = VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Opening-base Churn], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Matching Period
		lineageTag: 47cafde1-cae3-5ed0-85c8-ea7f734c9bc0

	/// Monthly Retention Prior Year
	measure 'Monthly Retention Prior Year' = VAR MatchingMonths = SELECTCOLUMNS(VALUES(DimHistoryMonth[month]), "Month", EDATE(DimHistoryMonth[month], -12)) VAR PriorMonths = CALCULATE(DISTINCTCOUNT(FactHistory[month]), REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])) RETURN IF(PriorMonths = COUNTROWS(MatchingMonths), CALCULATE([Monthly Retention], REMOVEFILTERS(DimHistoryMonth), TREATAS(MatchingMonths, DimHistoryMonth[month])))
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Matching Period
		lineageTag: 4d8ebcd5-86b8-573d-9fd1-4a1f25ec48be

	/// Net Revenue YoY
	measure 'Net Revenue YoY' = VAR Previous = [Net Revenue Prior Year] RETURN IF(NOT ISBLANK(Previous) && Previous <> 0, DIVIDE([Net Revenue] - Previous, Previous))
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Matching Period
		lineageTag: 717e5200-e0d0-5475-a3c2-73e96a1d859f

	/// Closing Members YoY
	measure 'Closing Members YoY' = VAR Previous = [Closing Members Prior Year] RETURN IF(NOT ISBLANK(Previous) && Previous <> 0, DIVIDE([Closing Members] - Previous, Previous))
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Matching Period
		lineageTag: fb82a13c-cf05-5f76-a3a9-d73969060dd6

	/// Average Members YoY
	measure 'Average Members YoY' = VAR Previous = [Average Members Prior Year] RETURN IF(NOT ISBLANK(Previous) && Previous <> 0, DIVIDE([Average Members] - Previous, Previous))
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Matching Period
		lineageTag: 14483d7e-0bb6-5950-b9ba-8aeddf52cadd

	/// Acquisitions YoY
	measure 'Acquisitions YoY' = VAR Previous = [Acquisitions Prior Year] RETURN IF(NOT ISBLANK(Previous) && Previous <> 0, DIVIDE([Acquisitions] - Previous, Previous))
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Matching Period
		lineageTag: 597ed928-dc5a-57a0-982d-915098f7abc1

	/// ARPMM YoY
	measure 'ARPMM YoY' = VAR Previous = [ARPMM Prior Year] RETURN IF(NOT ISBLANK(Previous) && Previous <> 0, DIVIDE([ARPMM] - Previous, Previous))
		formatString: 0.00%;−0.00%;0.00%
		displayFolder: Matching Period
		lineageTag: 28081f77-2747-5009-b99c-579f7435e567

	/// Qualified Conversion Change pp
	measure 'Qualified Conversion Change pp' = VAR Previous = [Qualified Conversion Prior Year] RETURN IF(NOT ISBLANK(Previous) && NOT ISBLANK([Qualified Conversion]), ([Qualified Conversion] - Previous) * 100)
		formatString: 0.00" pp"
		displayFolder: Matching Period
		lineageTag: 7e2c4eab-383d-5e34-92c0-1305dec4dec3

	/// Opening-base Churn Change pp
	measure 'Opening-base Churn Change pp' = VAR Previous = [Opening-base Churn Prior Year] RETURN IF(NOT ISBLANK(Previous) && NOT ISBLANK([Opening-base Churn]), ([Opening-base Churn] - Previous) * 100)
		formatString: 0.00" pp"
		displayFolder: Matching Period
		lineageTag: 598b60a6-5f31-52ab-b9af-a700f275c824

	/// Monthly Retention Change pp
	measure 'Monthly Retention Change pp' = VAR Previous = [Monthly Retention Prior Year] RETURN IF(NOT ISBLANK(Previous) && NOT ISBLANK([Monthly Retention]), ([Monthly Retention] - Previous) * 100)
		formatString: 0.00" pp"
		displayFolder: Matching Period
		lineageTag: 9b3ffd2e-0a01-5f62-b654-b125937a140d

	/// Matching-period change for executive KPI. Percent growth; churn in percentage points; incomplete prior observations remain unavailable.
	measure 'Executive Revenue Comparison' = VAR Change = [Net Revenue YoY] RETURN IF(ISBLANK(Change), "Prior period unavailable", "vs " & FORMAT(MAX(DimHistoryMonth[year])-1,"0") & ": " & FORMAT(Change,"+0.00%;−0.00%;0.00%"))
		displayFolder: Matching Period
		lineageTag: 4aed472b-4afe-502b-a719-331c82b501d2

	/// Matching-period change for executive KPI. Percent growth; churn in percentage points; incomplete prior observations remain unavailable.
	measure 'Executive Members Comparison' = VAR Change = [Closing Members YoY] RETURN IF(ISBLANK(Change), "Prior period unavailable", "vs " & FORMAT(MAX(DimHistoryMonth[year])-1,"0") & ": " & FORMAT(Change,"+0.00%;−0.00%;0.00%"))
		displayFolder: Matching Period
		lineageTag: 15ac43a6-1249-517e-98b6-4061b653ed5c

	/// Matching-period change for executive KPI. Percent growth; churn in percentage points; incomplete prior observations remain unavailable.
	measure 'Executive ARPMM Comparison' = VAR Change = [ARPMM YoY] RETURN IF(ISBLANK(Change), "Prior period unavailable", "vs " & FORMAT(MAX(DimHistoryMonth[year])-1,"0") & ": " & FORMAT(Change,"+0.00%;−0.00%;0.00%"))
		displayFolder: Matching Period
		lineageTag: 672c2b5d-3e0d-50b1-83c5-6eda890a7959

	/// Matching-period change for executive KPI. Percent growth; churn in percentage points; incomplete prior observations remain unavailable.
	measure 'Executive Acquisition Comparison' = VAR Change = [Acquisitions YoY] RETURN IF(ISBLANK(Change), "Prior period unavailable", "vs " & FORMAT(MAX(DimHistoryMonth[year])-1,"0") & ": " & FORMAT(Change,"+0.00%;−0.00%;0.00%"))
		displayFolder: Matching Period
		lineageTag: bf34c061-73c7-5089-96a9-bf0ca2689fa7

	/// Matching-period change for executive KPI. Percent growth; churn in percentage points; incomplete prior observations remain unavailable.
	measure 'Executive Churn Comparison' = VAR Change = [Opening-base Churn Change pp] RETURN IF(ISBLANK(Change), "Prior period unavailable", "vs " & FORMAT(MAX(DimHistoryMonth[year])-1,"0") & ": " & FORMAT(Change,"+0.00;−0.00;0.00") & " pp")
		displayFolder: Matching Period
		lineageTag: 9996ca47-360b-563b-b979-6a0c412fcf24

	/// Q4 Net Revenue
	measure 'Q4 Net Revenue' = CALCULATE([Net Revenue], REMOVEFILTERS(DimHistoryMonth), DimHistoryMonth[year] = 2025, DimHistoryMonth[quarter] = "Q4")
		formatString: £#,##0;−£#,##0;£0
		displayFolder: Q4 Context
		lineageTag: f44d27bd-277b-51b6-a210-dc76d0c1e084

	/// Q4 Net Revenue 2024
	measure 'Q4 Net Revenue 2024' = CALCULATE([Net Revenue], REMOVEFILTERS(DimHistoryMonth), DimHistoryMonth[year] = 2024, DimHistoryMonth[quarter] = "Q4")
		formatString: £#,##0;−£#,##0;£0
		displayFolder: Q4 Context
		lineageTag: 7b5ad564-5902-582d-a6ed-95a8e6887f1d

	/// Q4 Net Revenue Growth
	measure 'Q4 Net Revenue Growth' = VAR Previous = [Q4 Net Revenue 2024] RETURN DIVIDE([Q4 Net Revenue] - Previous, Previous)
		formatString: 0.00%;−0.00%;0.00%
