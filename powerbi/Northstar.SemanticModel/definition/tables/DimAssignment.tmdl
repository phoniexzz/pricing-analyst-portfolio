table DimAssignment
	lineageTag: 6488622f-bb32-56c3-8fa7-49773f2b4491

	column assignment
		dataType: string
		lineageTag: 00b1d626-5b78-50ce-843b-9c2c71fc047b
		summarizeBy: none
		sourceColumn: assignment

	partition DimAssignment = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceRoot & "/DimAssignment.csv"), [Delimiter=",", Columns=1, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"assignment", type text}}, "en-GB")
				in
				    Typed

