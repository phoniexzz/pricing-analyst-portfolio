table DimHistoryMonth
	lineageTag: 63169077-a742-56a8-89a7-150fc65dc099

	column month
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: d03a1a3a-9294-5860-a090-4bec790fd5f4
		summarizeBy: none
		sourceColumn: month

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		formatString: #,##0
		lineageTag: 41150fc4-dbaf-5947-a395-2d4757d0a0ad
		summarizeBy: none
		sourceColumn: year

	column month_number
		dataType: int64
		formatString: #,##0
		lineageTag: cda0e4e1-7e00-50f4-87fc-70f67ca65bd2
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		lineageTag: d4eb0cfb-dde2-5965-a881-eb3f9a3f2d91
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_number

	column quarter
		dataType: string
		lineageTag: 9621b1e7-6814-5a4d-80e7-805adcacfda7
		summarizeBy: none
		sourceColumn: quarter

	column year_month
		dataType: string
		lineageTag: 066288f1-891f-5a94-823c-aad2073c7927
		summarizeBy: none
		sourceColumn: year_month

	partition DimHistoryMonth = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceRoot & "/DimHistoryMonth.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"month", type date}, {"year", Int64.Type}, {"month_number", Int64.Type}, {"month_name", type text}, {"quarter", type text}, {"year_month", type text}}, "en-GB")
				in
				    Typed

