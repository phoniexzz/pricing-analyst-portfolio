table DimPopulation
	lineageTag: d548de93-b167-5742-beda-72be9c49d69d

	column population
		dataType: string
		lineageTag: 8396c309-570a-5951-adc0-c916a7e4ee81
		summarizeBy: none
		sourceColumn: population

	column sort_order
		dataType: int64
		formatString: #,##0
		lineageTag: 318cedc0-f84c-5e2f-975f-7c5da4149dcc
		summarizeBy: none
		sourceColumn: sort_order

	partition DimPopulation = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceRoot & "/DimPopulation.csv"), [Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"population", type text}, {"sort_order", Int64.Type}}, "en-GB")
				in
				    Typed

