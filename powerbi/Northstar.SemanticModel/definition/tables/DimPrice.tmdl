table DimPrice
	lineageTag: 3994b279-eaa3-5508-a3f5-bcb75bda848e

	column price_increment
		dataType: int64
		formatString: #,##0
		lineageTag: e1e58c58-d838-5f43-82b5-380497b72155
		summarizeBy: none
		sourceColumn: price_increment

	column sort_order
		dataType: int64
		formatString: #,##0
		lineageTag: c8aa138a-88d4-5345-b709-c020aa310bf8
		summarizeBy: none
		sourceColumn: sort_order

	column label
		dataType: string
		lineageTag: 751e71d4-bcd0-5622-9173-d62ad9c0a9c9
		summarizeBy: none
		sourceColumn: label
		sortByColumn: sort_order

	partition DimPrice = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceRoot & "/DimPrice.csv"), [Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"price_increment", Int64.Type}, {"sort_order", Int64.Type}, {"label", type text}}, "en-GB")
				in
				    Typed

