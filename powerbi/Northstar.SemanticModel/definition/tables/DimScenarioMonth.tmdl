table DimScenarioMonth
	lineageTag: 63bf048b-b839-5baf-a247-41ca414cf9d5

	column month
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 1bf11052-4ab7-572c-be58-da003a68e3e9
		summarizeBy: none
		sourceColumn: month

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		formatString: #,##0
		lineageTag: b05a2d81-3891-5f97-812e-a6d90ec0917b
		summarizeBy: none
		sourceColumn: year

	column month_number
		dataType: int64
		formatString: #,##0
		lineageTag: be9ffaf7-aa7b-5f0d-90cd-ef5fa380ce74
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		lineageTag: 77cb7ad0-84ce-5a14-8d31-aa3da8965f5b
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_number

	column quarter
		dataType: string
		lineageTag: 5c8f858b-954b-5134-8406-e2a80d7e3143
		summarizeBy: none
		sourceColumn: quarter

	column year_month
		dataType: string
		lineageTag: 686b3b68-1a49-5ba3-9824-802cdb009c92
		summarizeBy: none
		sourceColumn: year_month

	partition DimScenarioMonth = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceRoot & "/DimScenarioMonth.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"month", type date}, {"year", Int64.Type}, {"month_number", Int64.Type}, {"month_name", type text}, {"quarter", type text}, {"year_month", type text}}, "en-GB")
				in
				    Typed

