	partition FactScenarioEstate = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceRoot & "/FactScenarioEstate.csv"), [Delimiter=",", Columns=95, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
